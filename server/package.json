    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jose": "5.9.6",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.11",
    "pg": "^8.13.1",
    "socket.io": "^4.8.4",
    "ws": "8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
