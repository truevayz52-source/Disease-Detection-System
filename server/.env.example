PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# LAN discovery beacon — broadcasts "DDS:<lanIp>:<port>" on UDP 40401 every
# 3s so the mobile app can auto-find this API on the local network.
# Set to 0 to disable.
DISCOVERY_BEACON=1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dds_db

JWT_SECRET=change-me-generate-64-hex-chars
JWT_EXPIRES_HOURS=8

ANALYTICS_URL=http://127.0.0.1:8000
OUTBREAK_THRESHOLD=8
OUTBREAK_WINDOW_HOURS=48

# Session time zone applied to each pooled MySQL connection (fixed offset;
# Zimbabwe has no DST). NOW()/CURDATE() in detection queries follow this.
MYSQL_TIMEZONE=+02:00

# Optional shared secret for the public community-report endpoint
# (POST /api/community/report). When set, callers must send it as x-api-key.
COMMUNITY_API_KEY=

# Optional SMTP delivery; TLS is required. Do not commit real credentials.
# Free forever options ($0, no monthly): Ethereal for dev (mail captured at
# https://ethereal.email — created instantly, no signup) or Brevo for real
# delivery (300 emails/day free, smtp-relay.brevo.com:587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional inference endpoints. Configure only approved services.
# Bundled dev pathology service: pnpm dev:pathology → http://127.0.0.1:8002/analyze
PATHOLOGY_INFERENCE_URL=
PATHOLOGY_API_KEY=
# HF image-classification model id for analytics/pathology.py — requires
# `pip install -r analytics/requirements-pathology-ml.txt` (~2.5GB torch).
# Unset → deterministic heuristic analyzer (dds-patho-heuristic-1.0).
PATHOLOGY_MODEL=
WHISPER_URL=
WHISPER_API_KEY=
# Streaming transcription socket on the Whisper service. Optional — derived
# from WHISPER_URL as ws(s)://host/stream when unset.
WHISPER_WS_URL=

# Regional bridge — pushes district-level mortality AGGREGATES (never case
# data) via POST /api/regional/push.
# DHIS2 (Zimbabwe HMIS): POST {DHIS2_BASE_URL}/api/dataValueSets.
# Dev demo: DHIS2_BASE_URL=https://play.im.dhis2.org/stable-2-43-2
#           DHIS2_USERNAME=admin DHIS2_PASSWORD=district
#           DHIS2_DATASET=pBOMPrpg1QX DHIS2_ORGUNIT=O6uvpzGd5pu
#           DHIS2_ELEMENT_MAP={"*":"f7n9E0hX8qk"}
DHIS2_BASE_URL=
DHIS2_API_TOKEN=
DHIS2_USERNAME=
DHIS2_PASSWORD=
DHIS2_DATASET=
DHIS2_ORGUNIT=
# JSON map disease_category → dataElement id; "*" is the catch-all.
DHIS2_ELEMENT_MAP=
# OpenHIM mediator channel (FHIR R4 MeasureReport bundle).
OPENHIM_BASE_URL=
OPENHIM_TOKEN=
OPENHIM_CHANNEL_PATH=/dds/mortality

# WHO client credentials and a published ICD-11 MMS release identifier.
# Register at https://icd.who.int/icdapi → "View API access key" → paste the
# clientId/clientSecret; WHO_ICD_RELEASE e.g. 2025-01.
WHO_CLIENT_ID=
WHO_CLIENT_SECRET=
WHO_ICD_RELEASE=

# Dynamic text translation (POST /api/translate). Text is de-identified
# (names, IDs, phones, coords replaced with placeholders) before dispatch —
# the provider never receives patient or organisational data. Leave
# GEMINI_API_KEY empty to disable; clients then fall back to the bundled
# offline medical glossary.
TRANSLATE_PROVIDER=gemini
GEMINI_API_KEY=
TRANSLATE_MODEL=gemini-3.1-flash-lite
