# API
PORT=4001
CLIENT_ORIGIN=http://localhost:5174
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_HOURS=8
# 64-hex key independent of JWT_SECRET — REQUIRED in production (config
# throws without it). Generate: openssl rand -hex 32
SIGNATURE_HMAC_KEY=dev-hmac-key
DB_TIMEZONE=Africa/Harare

# Database — Supabase Postgres (Supavisor pooler, port 6543).
# Dashboard → Settings → Database → Connection string (pooler, transaction mode):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local Postgres also works: postgresql://postgres:postgres@127.0.0.1:5432/dds_db
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Set to false only for a local dev database without TLS.
DATABASE_SSL=true

# Supabase (server-side only — never expose to the mobile/web bundles)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<sb_secret_...>
# Needed for hybrid auth (Phase 2): verifies Supabase-issued JWTs.
# Legacy HS256 projects: the JWT secret from Settings → JWT Keys.
# Newer projects may sign asymmetrically — JWKS is used automatically.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json

# LAN discovery beacon for mobile auto-find (UDP 40401). Off in production.
DISCOVERY_BEACON=1

# Shared secret for POST /api/community/report (community surveillance)
COMMUNITY_API_KEY=

# Outbreak auto-detection (every 8 min)
OUTBREAK_THRESHOLD=8
OUTBREAK_WINDOW_HOURS=48

# Low-volume early-warning layer — cumulative detection, no meaningful time
# gate (90-day window) so sparse clusters alert quickly. Tighten in production.
EARLY_WARNING_MIN_CASES=2
EARLY_WARNING_WINDOW_HOURS=2160
EARLY_WARNING_RISK_SCORE=35
CUSUM_LIMIT=3
PREDICTIONS_MIN_POINTS=3

# Optional services
ANALYTICS_URL=http://localhost:8000
PATHOLOGY_INFERENCE_URL=http://localhost:8002
PATHOLOGY_MODEL=default
PATHOLOGY_API_KEY=
WHISPER_URL=http://localhost:8001
WHISPER_API_KEY=

# Narrative translation (Gemini) — /api/translate + /api/i18n/fill.
# Requests are de-identified server-side before leaving the process.
TRANSLATE_PROVIDER=gemini
TRANSLATE_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# WHO ICD-11 — register at https://icd.who.int/icdapi
# WHO_ICD_RELEASE is the release id only ("2025-01") — the API appends /mms.
WHO_CLIENT_ID=
WHO_CLIENT_SECRET=
WHO_ICD_RELEASE=2025-01

# Regional bridge — unconfigured targets are skipped at push time.
# OpenHIM (see deploy/openhim/): router URL + client customTokenID.
OPENHIM_BASE_URL=
OPENHIM_TOKEN=
OPENHIM_CHANNEL_PATH=/dds/mortality
# DHIS2 (aggregates only): token OR basic auth.
DHIS2_BASE_URL=
DHIS2_DATASET=
DHIS2_ORGUNIT=
DHIS2_API_TOKEN=
DHIS2_USERNAME=
DHIS2_PASSWORD=
# JSON map: local field name -> DHIS2 data element id
DHIS2_ELEMENT_MAP={}

# Password reset WITHOUT SMTP: deliver the reset link via an HTTP webhook.
PASSWORD_RESET_WEBHOOK_URL=
PASSWORD_RESET_WEBHOOK_SECRET=

# Email (optional) — password resets + report schedule notices.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
